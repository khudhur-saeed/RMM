# ==============================================================================
# Tactical RMM Production Environment Configuration Template
# Copy to `.env` and replace placeholder secrets with high-entropy values.
# ==============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=rmm_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=tactical_rmm
POSTGRES_PORT=5433

# Redis In-Memory Telemetry & C2 Broker
REDIS_PORT=6379
REDIS_PASSWORD=

# Control Plane RBAC Bootstrap Tokens
ADMIN_API_TOKEN=CHANGE_ME_HIGH_ENTROPY_SUPERADMIN_TOKEN
TECHNICIAN_API_TOKEN=
AUDITOR_API_TOKEN=

# Host Port Bindings (Bound to 127.0.0.1)
SERVER_PORT=8000
FRONTEND_PORT=8080
